# Required: Your OpenAI API key
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: Server API key for authentication
# If set, all /api/* requests must include X-API-KEY header
SERVER_API_KEY=your-secret-key-here

# Optional: AI Model (defaults to gpt-4o - most advanced)
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
AI_MODEL=gpt-4o

# Optional: Max tokens for responses (defaults to 4096)
# Can be set up to 150K depending on model and usage
MAX_TOKENS=4096

# Optional: Port (defaults to 3000)
PORT=3000
