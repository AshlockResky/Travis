# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Security
SERVER_API_KEY=your-secret-key-here

# AI Configuration
AI_MODEL=gpt-4o
MAX_TOKENS=8192

# ==================== REAL-TIME KNOWLEDGE SOURCES ====================

# Google Search (for internet searches)
GOOGLE_API_KEY=your-google-api-key
